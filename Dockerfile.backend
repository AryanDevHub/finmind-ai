# Dockerfile.backend — FastAPI + fraud model + ChromaDB RAG
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install CPU-only torch FIRST, from PyTorch's own CPU index.
# sentence-transformers pulls torch too, but since it's already
# satisfied here, pip won't reach for the ~2.5GB CUDA/GPU build.
# This container never uses a GPU, so the CPU build is all we need.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements-backend.txt .
RUN pip install --no-cache-dir -r requirements-backend.txt

COPY backend/ ./backend/
COPY ml_models/ ./ml_models/

RUN mkdir -p /app/database

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]