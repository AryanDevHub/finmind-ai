# Copy to .env and fill in. NEVER commit .env.

# ── Required ─────────────────────────────────────────────────────
# JWT signing key (>= 32 chars). Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Chat (optional; /chat returns 503 without it). Free key: https://console.groq.com
GROQ_API_KEY=

# ── Local development (running uvicorn/celery on your machine) ───
DATABASE_URL=postgresql://finmind:finmind_dev_password@localhost:5432/finmind
REDIS_URL=redis://localhost:6379/0
COOKIE_SECURE=false                   # plain-HTTP local dev only. MUST be true when served over HTTPS
CORS_ORIGINS=http://localhost:8501    # comma-separated explicit origins, never '*'
APP_TIMEZONE=Asia/Kolkata

# ── Docker Compose only ──────────────────────────────────────────
POSTGRES_PASSWORD=finmind_dev_password
